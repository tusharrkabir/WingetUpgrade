<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>Winget Upgrade</Title>
    <Product>Winget Upgrade</Product>
    <Description>A modern, high-performance, hardware-accelerated desktop GUI client for Windows Package Manager (winget CLI) built with .NET 8 WPF.</Description>
    <Authors>Tusharr Kabir</Authors>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/tusharrkabir/WingetUpgrade</RepositoryUrl>
  </PropertyGroup>

</Project>
